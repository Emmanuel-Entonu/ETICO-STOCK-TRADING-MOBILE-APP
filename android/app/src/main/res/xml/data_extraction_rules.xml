<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ data extraction rules. Disable both cloud backup and
     device-to-device transfer of app data. Session tokens, PIN state, and
     any local KYC data must never leave the device via ADB backup or
     Google's automatic app-data backups. -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </device-transfer>
</data-extraction-rules>
