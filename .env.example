# All variables prefixed with EXPO_PUBLIC_ ship to the app bundle.
# Only put here what is safe to be extracted from the built APK/IPA.
# Secrets (PAC creds, Moneta client secret, MAC key) live on the BaaS proxies — never here.

EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Proxy base URLs (all point to the Vercel deployment of the current web project).
# Once the BaaS exists these all collapse into one: EXPO_PUBLIC_BAAS_URL.
EXPO_PUBLIC_PROXY_BASE=https://moneta-app.vercel.app
