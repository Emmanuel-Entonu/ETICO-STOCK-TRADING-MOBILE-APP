{
  "expo": {
    "name": "ETICO",
    "slug": "moneta-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "niqra",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/brand/etico-icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ng.moneta.capital"
    },
    "android": {
      "package": "ng.moneta.capital",
      "versionCode": 4,
      "allowBackup": false,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/etico-adaptive-foreground.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#DAA92F",
          "mode": "production"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "buildToolsVersion": "36.1.0"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ETICO uses your camera to take a verification selfie for KYC.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withEticoNative"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "pacProxyUrl": "",
      "mdsProxyUrl": "",
      "nibssProxyUrl": "",
      "monetaProxyUrl": "",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "08384831-fdc8-4bd3-a4e9-67eeb5495735"
      }
    },
    "owner": "emmanuel-entonu"
  }
}
