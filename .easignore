# Keep the EAS upload small — exclude build outputs and local-only artifacts.
# (EAS regenerates native builds in the cloud; it only needs sources + config.)
android.bak/
android/.gradle/
android/build/
android/app/build/
android/app/.cxx/
android/app/.gradle/
# Whole ios/ tree — not needed for an Android build.
ios/
**/*.apk
**/*.aab
**/*.keystore
android/keystore.properties
*.log
# Large local media (not used by the app) — kept out of every build upload.
niqra-screen-recording.mp4
screen.png
*.mp4
# Local signing secrets: EAS reads credentials.json from disk and uploads the
# keystore through its credentials flow; the source archive must not carry them.
credentials.json
credentials/
*.p8
*.p12
*.mobileprovision
